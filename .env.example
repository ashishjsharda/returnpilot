# ---- Model backend ----
# Strands defaults to AWS Bedrock. Make sure your AWS credentials below have
# Bedrock model access enabled (Anthropic Claude) in your target region.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=us-east-1

# ---- AWS credentials ----
# Fill these in with your hackathon AWS account's credentials, OR configure
# the AWS CLI (`aws configure`) / an AWS_PROFILE instead and leave these blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Storage backend ----
# "local"    -> SQLite file at data/returnpilot.db (no AWS needed, fastest to demo)
# "dynamodb" -> real DynamoDB table (created automatically if missing, needs AWS creds)
RETURNPILOT_STORAGE=local
DYNAMODB_TABLE=ReturnPilotPurchases

# ---- Approval threshold ----
# Purchases at or above this price always require human approval.
APPROVAL_THRESHOLD_USD=200
