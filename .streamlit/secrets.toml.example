# Copy this into Streamlit Community Cloud's "Settings -> Secrets" panel for
# your deployed app (paste it there directly, don't upload a file). It's
# encrypted server-side and never touches this repo — .streamlit/secrets.toml
# itself is gitignored, so don't remove it from .gitignore.
#
# Once set, every visitor to your deployed app gets a working live-Bedrock
# demo automatically, no manual credential entry needed.

AWS_ACCESS_KEY_ID = "your-access-key-id"
AWS_SECRET_ACCESS_KEY = "your-secret-access-key"
AWS_REGION = "us-east-1"
BEDROCK_MODEL_ID = "arn:aws:bedrock:us-east-1:680319777945:inference-profile/us.anthropic.claude-sonnet-4-6"
